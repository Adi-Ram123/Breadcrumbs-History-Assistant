{
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "cited": {
            "items": {
              "type": "string"
            },
            "title": "Cited",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "cited"
        ],
        "title": "Answer",
        "type": "object"
      },
      "AnswerRequest": {
        "properties": {
          "ask_id": {
            "title": "Ask Id",
            "type": "string"
          }
        },
        "required": [
          "ask_id"
        ],
        "title": "AnswerRequest",
        "type": "object"
      },
      "AnswerResponse": {
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/Answer"
          },
          "fallback_reason": {
            "anyOf": [
              {
                "enum": [
                  "llm_off",
                  "rejected_citation",
                  "llm_error"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Reason"
          },
          "mode": {
            "enum": [
              "llm",
              "template"
            ],
            "title": "Mode",
            "type": "string"
          },
          "timings_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings Ms",
            "type": "object"
          }
        },
        "required": [
          "answer",
          "mode",
          "fallback_reason",
          "timings_ms"
        ],
        "title": "AnswerResponse",
        "type": "object"
      },
      "AskRequest": {
        "properties": {
          "now": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Now"
          },
          "question": {
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "tz": {
            "title": "Tz",
            "type": "string"
          }
        },
        "required": [
          "question",
          "tz"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "description": "Intent and rows, fast. The LLM sentence comes later from POST /answer with `ask_id`.",
        "properties": {
          "ask_id": {
            "title": "Ask Id",
            "type": "string"
          },
          "history_start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "History Start"
          },
          "intent": {
            "$ref": "#/components/schemas/Intent"
          },
          "mode": {
            "enum": [
              "results",
              "no-match"
            ],
            "title": "Mode",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/Result"
            },
            "title": "Results",
            "type": "array"
          },
          "template_answer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Answer"
              },
              {
                "type": "null"
              }
            ]
          },
          "timings_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings Ms",
            "type": "object"
          },
          "window_counts": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WindowCounts"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ask_id",
          "question",
          "intent",
          "results",
          "template_answer",
          "mode",
          "window_counts",
          "history_start",
          "timings_ms"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "embedder_version": {
            "title": "Embedder Version",
            "type": "string"
          },
          "entry_count": {
            "title": "Entry Count",
            "type": "integer"
          },
          "history_start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "History Start"
          },
          "llm_mode": {
            "title": "Llm Mode",
            "type": "string"
          },
          "parser": {
            "title": "Parser",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "embedder_version",
          "parser",
          "llm_mode",
          "entry_count",
          "history_start"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IngestEntry": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "kind": {
            "enum": [
              "search",
              "visit"
            ],
            "title": "Kind",
            "type": "string"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "source": {
            "enum": [
              "live",
              "backfill",
              "seed"
            ],
            "title": "Source",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "title": {
            "default": "",
            "title": "Title",
            "type": "string"
          },
          "url": {
            "minLength": 1,
            "title": "Url",
            "type": "string"
          },
          "visit_time": {
            "format": "date-time",
            "title": "Visit Time",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "url",
          "visit_time",
          "source"
        ],
        "title": "IngestEntry",
        "type": "object"
      },
      "IngestRequest": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/IngestEntry"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Entries",
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "title": "IngestRequest",
        "type": "object"
      },
      "IngestResponse": {
        "properties": {
          "ids": {
            "items": {
              "type": "string"
            },
            "title": "Ids",
            "type": "array"
          }
        },
        "required": [
          "ids"
        ],
        "title": "IngestResponse",
        "type": "object"
      },
      "Intent": {
        "properties": {
          "kind": {
            "enum": [
              "search",
              "visit",
              "any"
            ],
            "title": "Kind",
            "type": "string"
          },
          "limit": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          },
          "order": {
            "default": "relevance",
            "enum": [
              "recent",
              "relevance"
            ],
            "title": "Order",
            "type": "string"
          },
          "time_range": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimeRange"
              },
              {
                "type": "null"
              }
            ]
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic"
          }
        },
        "required": [
          "kind"
        ],
        "title": "Intent",
        "type": "object"
      },
      "Result": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "search",
              "visit"
            ],
            "title": "Kind",
            "type": "string"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "visit_time": {
            "format": "date-time",
            "title": "Visit Time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "url",
          "visit_time"
        ],
        "title": "Result",
        "type": "object"
      },
      "TimeRange": {
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "TimeRange",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WindowCounts": {
        "description": "Stored entries of each kind inside a time window, ignoring the topic.",
        "properties": {
          "search": {
            "title": "Search",
            "type": "integer"
          },
          "visit": {
            "title": "Visit",
            "type": "integer"
          }
        },
        "required": [
          "search",
          "visit"
        ],
        "title": "WindowCounts",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Breadcrumbs",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/answer": {
      "post": {
        "operationId": "answer_answer_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Answer"
      }
    },
    "/ask": {
      "post": {
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask"
      }
    },
    "/entries/{entry_id}": {
      "delete": {
        "operationId": "delete_entries__entry_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "entry_id",
            "required": true,
            "schema": {
              "title": "Entry Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/ingest": {
      "post": {
        "operationId": "ingest_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ingest"
      }
    }
  }
}
