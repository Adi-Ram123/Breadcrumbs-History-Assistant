# Copy to backend/.env and adjust. All values are optional.
# Default: <repo>/data/breadcrumbs.db. Use an absolute path to override.
# DB_PATH=
DEFAULT_TZ=America/Chicago
# stub | rules | llm | tagger
PARSER=stub
# minilm | <path to ml/models/retriever/<version>>
EMBEDDER=minilm
# off | live | replay | record
LLM_MODE=off
# 1 lets POST /ask accept a fixed "now" (tests and demo only)
DEBUG_FIXED_NOW=0
# chrome-extension://<id>, set from extension/scripts/gen-key.sh
EXTENSION_ORIGIN=chrome-extension://pengpbbmpcbooclpejbchalnjamfgbmm
